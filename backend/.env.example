NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:password@localhost:5432/bookleaf

# Use random secrets of at least 32 characters. ACCESS_TOKEN_SECRET is kept
# for compatibility with this backend; JWT_SECRET is accepted as an alias.
ACCESS_TOKEN_SECRET=replace_with_a_long_random_secret_at_least_32_chars
REFRESH_TOKEN_SECRET=replace_with_a_different_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=15m

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
CLIENT_URL=http://localhost:5173

# Point at the supplied 10-author / 18-book JSON before running `npm run seed`.
BOOKLEAF_DATASET=./data/bookleaf.json
ALLOW_REMOTE_MIGRATIONS=false
# For a verified remote development database only, set the exact hostname:
# MIGRATION_TARGET_HOST=your-development-database-host

# Development-only demo accounts created by the guarded seed script.
DEMO_ADMIN_EMAIL=admin@bookleaf.local
DEMO_ADMIN_PASSWORD=BookLeafAdmin!2026
DEMO_AUTHOR_EMAIL=author@bookleaf.local
DEMO_AUTHOR_PASSWORD=BookLeafAuthor!2026
